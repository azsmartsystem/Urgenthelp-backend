# ALLinHELP Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Runtime ───────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
DEBUG=true

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://allinhelp:password@localhost:5432/allinhelp_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_TOO
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=*

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME

# ── AWS S3 / Cloudflare R2 ────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=allinhelp-media-dev
AWS_S3_REGION=us-east-1
# For Cloudflare R2, uncomment and set:
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com

# ── Firebase (Push Notifications) ─────────────────────────
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# ── Google Maps ───────────────────────────────────────────
GOOGLE_MAPS_API_KEY=CHANGE_ME

# ── Sentry (optional) ─────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ── Platform Config ───────────────────────────────────────
COMMISSION_RATE=0.10
MAX_HELPER_MATCH_RADIUS_KM=20.0
DEFAULT_MATCH_RADIUS_KM=5.0
